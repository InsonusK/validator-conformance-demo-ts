{
  "name": "@insonusk/validator-conformance-demo-ts",
  "version": "0.1.0",
  "description": "Demo TypeScript validators (email, date range, amount, id array) conformance-tested against cross-platform Cucumber specs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsonusK/validator-conformance-demo-ts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "cucumber-js 'specs/features/**/*.feature' --require-module ts-node/register --require 'test/steps/**/*.ts' --require 'test/support/**/*.ts' --format ./test/support/pretty-formatter.cts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@cucumber/pretty-formatter": "^4.0.0",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "ts-node": {
    "transpileOnly": true
  },
  "license": "MIT"
}
